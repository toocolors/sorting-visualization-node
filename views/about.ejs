<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Sorting Visualization</title>
    <link rel="stylesheet" href="/css/globalStyles.css">
    <link rel="stylesheet" href="/css/aboutStyles.css">
    <link rel="stylesheet" href="/css/navStyles.css">
</head>
<body>
    <!-- Container -->
    <div id="container">
        <!-- Nav -->
        <%- include('partials/nav.ejs') %>
        <div id="overlay"></div>

        <!-- Main Content -->
        <main>
            <!-- Top Bar -->
            <div id="topBar">
                    <!-- Hamburger Button -->
                    <button id="menuToggle">☰</button>

                    <!-- Heading -->
                    <h1 id="mainHeading">About</h1>
            </div>

            <!-- Information -->
            <div id="flexbox">
                <div class="border">
                    <!-- Heading -->
                    <h2>What is this?</h2>
                </div>

                <div class="border">
                    <!-- Heading -->
                    <h2>Principle Sorts</h2>

                    <!-- Descripion -->

                    <!-- Table -->
                    <%- include('partials/tableHead.ejs') %>
                        <!-- Bubble Sort -->
                        <%- include('partials/tables/bubbleTable.ejs') %>

                        <!-- Insertion Sort -->
                        <%- include('partials/tables/insertionTable.ejs') %>

                        <!-- Selection Sort -->
                        <%- include('partials/tables/selectionTable.ejs') %>

                        <!-- Quick Sort -->
                        <%- include('partials/tables/quickTable.ejs') %>
                    </table>

                </div>

                <div class="border">
                    <!-- Heading -->
                    <h2>Asynchronous Sorts</h2>

                    <!-- Descripion -->

                    <!-- Table -->
                    <%- include('partials/tableHead.ejs') %>
                    </table>
                </div>

                <div class="border">
                    <!-- Heading -->
                    <h2>Joke Sorts</h2>

                    <!-- Descripion -->

                    <!-- Table -->
                    <%- include('partials/tableHead.ejs') %>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <script src="/js/about.js" type="text/javascript"></script>
    <script src="/js/sidebar.js" type="text/javascript"></script>
</body>
</html>