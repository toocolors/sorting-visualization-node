<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sorting Visualization</title>
    <link rel="stylesheet" href="/css/sorts-styles-ai.css">
</head>

<body>
    <!-- Container -->
    <div id="container">
        <!-- Nav -->
        <%- include('partials/nav.ejs') %>

            <main>
                <!-- Heading -->
                <h1 id="mainHeading">Sorting Algorithm Visualization</h1>

                <div id="flexbox">
                    <!-- Generation Div for Portrait -->
                    <div id="generationVertical"></div>

                    <!-- Array Visualization -->
                    <div id="visualization" class="border">
                        <!-- <div id="arrayDiv"></div> -->
                    </div>

                    <!-- Options Div -->
                    <div id="options">
                        <!-- Generation Div for Landscape -->
                        <div id="generationHorizontal">
                            <div id="generation" class="border">
                                <!-- Array Generation -->
                                <div id="generationOptions">
                                    Array Size:
                                    <input type="number" id="arraySize">
                                    <br>

                                    Array Type:
                                    <select id="arrayType">
                                        <option value="random-no-duplicates">Random (No Duplicates)</option>
                                        <option value="random-duplicates">Random (With Duplicates)</option>
                                        <option value="ascending">Ascending</option>
                                        <option value="alternating">Alternating</option>
                                        <option value="descending">Descending</option>
                                        <option value="bell-curve">Bell-Curve</option>
                                        <option value="pyramid">Pyramid</option>
                                    </select>
                                </div>

                                <button id="generate">Generate<br>Array</button>
                                <button id="generateGrayed" class="grayed hide">Generate<br>Array</button>
                            </div>
                        </div>

                        <div id="playback" class="centered border">
                            <!-- Sort Options -->
                            <div id="sortOptions">
                                <div id="sortSelectDiv">
                                    Sort:
                                    <select id="sortSelect"></select>
                                </div>
                                <div id="optionsDiv" class="inline-block"></div>
                            </div>
                            <br>

                            <!-- Play Button -->
                            <button id="play" class="sortControl hide largeLandscape">&#9658;</button>
                            <button id="playGrayed" class="sortControl grayed largeLandscape">&#9658;</button>

                            <!-- Step Button -->
                            <button id="step" class="sortControl hide largeLandscape">&#8594;</button>
                            <button id="stepGrayed" class="sortControl grayed largeLandscape">&#8594;</button>

                            <!-- Pause Button -->
                            <button id="pause" class="sortControl hide">&#x23F8;</button>
                            <button id="pauseGrayed" class="sortControl grayed">&#x23F8;</button>

                            <!-- Stop Button -->
                            <button id="stop" class="sortControl hide">&#x23F9;</button>
                            <button id="stopGrayed" class="sortControl grayed">&#x23F9;</button>

                            <!-- Audio Buttons -->
                            <button id="unmute" class="sortControl">&#128362;</button>
                            <button id="mute" class="sortControl hide">&#128360;</button>

                            <div id="speedControl">
                                <span id="speedSpan">Speed:</span>
                                <input id="speed" type="range" min="500" max="1000" value="1000">
                            </div>
                        </div>

                        <!-- Operation Count -->
                        <div id="operations">
                            <div id="accesses">
                                Accesses
                                <span id="accessesSpan">0</span>
                            </div>
                            <div id="comparisons">
                                Comparisons
                                <span id="comparisonsSpan">0</span>
                            </div>
                            <div id="reads">
                                Reads
                                <span id="readsSpan">0</span>
                            </div>
                            <div id="writes">
                                Writes
                                <span id="writesSpan">0</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Algorithm Information -->
                <div id="information" class="border">
                    <% try { %>
                        <%- include(`partials/info/${algorithmName}Info.ejs`) %>
                            <% } catch {} %>
                </div>
            </main>
    </div>

    <!-- Scripts -->
    <script>
        let currentAlgorithm = null;

        document.getElementById('<%= algorithmName %>').classList.add('currentAlgo');

        getInitialAlgorithm();

        async function getInitialAlgorithm() {
            currentAlgorithm = await import(`/get/algorithm?id=<%= algorithmName %>`);
        }
    </script>
    <script src="/js/globals.js" type="text/javascript"></script>
    <script src="/js/operations.js" type="text/javascript"></script>
    <script src="/js/controls.js" type="text/javascript"></script>
    <script src="/js/generation.js" type="text/javascript"></script>
</body>

</html>