<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sorting Visualization</title>
    <link rel="stylesheet" href="/css/sorts-styles.css">
</head>
<body>
    <h1>Sorting Algorithm Visualization</h1>

    <main>
        <!-- Nav -->
        <%- include('partials/nav.ejs') %>

        <!-- Array Visualization -->
        <div id="visualization">
            <div id="arrayDiv"></div>
        </div>

        <!-- Options Div -->
        <div id="options">
            <div id="generation">
                <!-- Array Generation -->
                Window Size:
                <input type="number" id="windowSize" value="50" max="4000">
                <button id="windowChange">Change</button>
                <button id="windowChangeGrayed" class="grayed hide">Change</button>
                <br>
                
                Array Size: 
                <input type="number" id="arraySize" value="20" max="4000">
                <br>
                
                Array Type: 
                <select id="arrayType">
                    <option value="random-no-duplicates">Random (No Duplicates)</option>
                    <option value="random-duplicates">Random (With Duplicates)</option>
                    <option value="ascending">Ascending</option>
                    <option value="alternating">Alternating</option>
                    <option value="descending">Descending</option>
                    <option value="bell-curve">Bell-Curve</option>
                    <option value="pyramid">Pyramid</option>
                </select>
                <br>

                <button id="generate" >Generate Array</button>
                <button id="generateGrayed" class="grayed hide">Generate Array</button>
            </div>
            <div id="playback">
                Sort:
                <select id="sortSelect"></select>
                <br>
                
                <!-- Play Button -->
                <button id="play" class="hide">&#9658;</button>
                <button id="playGrayed" class="grayed">&#9658;</button>
                
                <!-- Step Button -->
                <button id="step" class="hide">&#8594;</button>
                <button id="stepGrayed" class="grayed">&#8594;</button>
                <br>
                
                <!-- Pause Button -->
                <button id="pause" class="hide">&#x23F8;</button>
                <button id="pauseGrayed" class="grayed">&#x23F8;</button>
                
                <!-- Stop Button -->
                <button id="stop" class="hide">&#x23F9;</button>
                <button id="stopGrayed" class="grayed">&#x23F9;</button>
                <br>
                
                Speed: 
                <input id="speed" type="range" min="500" max="1000" value="1000">
                <br>

                <!-- Audio Buttons -->
                <button id="unmute">&#128362;</button>
                <button id="mute" class="hide">&#128360;</button>
            </div>
        </div>
    </main>
    
    <script>
        let currentAlgorithm = null;

        document.getElementById('<%= algorithmName %>').classList.add('currentAlgo');

        getInitialAlgorithm();

        async function getInitialAlgorithm() {
            currentAlgorithm = await import(`/get/algorithm?id=<%= algorithmName %>`);
        }
    </script>
    <script src="/js/globals.js" type="text/javascript"></script>
    <script src="/js/operations.js" type="text/javascript"></script>
    <script src="/js/controls.js" type="text/javascript"></script>
    <script src="/js/generation.js" type="text/javascript"></script>
</body>
</html>